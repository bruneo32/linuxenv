# PUT IN: $USER/.config/terminator/config
[global_config]
  handle_size = 2
  geometry_hinting = True
  scroll_tabbar = True
  inactive_color_offset = 0.82
  suppress_multiple_term_dialog = True
[keybindings]
[profiles]
  [[default]]
    background_color = "#300a24"
    foreground_color = "#ffffff"
    show_titlebar = False
    split_to_group = True
    title_transmit_bg_color = "#1c71d8"
    title_receive_bg_color = "#f5c211"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
